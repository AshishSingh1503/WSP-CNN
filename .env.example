# Copy to .env (git-ignored) and fill in. Never commit real keys.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Free/alternative providers (pick ONE LLM_PROVIDER above):
#   LLM_PROVIDER=groq            -> set GROQ_API_KEY ; LLM_MODEL=<a Groq model id>
#   LLM_PROVIDER=xai             -> set XAI_API_KEY  ; LLM_MODEL=<a Grok model id>
#   LLM_PROVIDER=openai_compatible -> set LLM_BASE_URL and LLM_API_KEY
GROQ_API_KEY=
XAI_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
